{
  "name": "rakshak-functions",
  "private": true,
  "description": "Rakshak backend: Cloud Functions for Firebase.",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.scripts.json",
