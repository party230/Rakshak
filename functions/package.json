  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "google-auth-library": "^10.0.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.0"
  }
}
